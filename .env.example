# ========================================================
# SHOPIFY LISTING AUTOMATION - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MySQL Database Configuration (Connection Pooling)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ems_shopify_automation
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# Shopify Default Credentials (Can also be managed per-store in the UI/DB)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# AI Provider Keys
# Google Gemini API Key for product titles, SEO descriptions, tags, and category classification
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key for Whisper Speech-To-Text (Voice Notes) and fallback generation
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Oracle Cloud Object Storage (S3-Compatible API)
# Product Images, Videos, Voice Notes
OCI_S3_ACCESS_KEY_ID=your_oci_customer_secret_key_id
OCI_S3_SECRET_ACCESS_KEY=your_oci_customer_secret_key
OCI_S3_REGION=us-ashburn-1
OCI_S3_BUCKET_NAME=ems-shopify-media
# Oracle S3 Endpoint format: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=https://your-tenancy-namespace.compat.objectstorage.us-ashburn-1.oraclecloud.com
OCI_S3_PUBLIC_BASE_URL=https://objectstorage.us-ashburn-1.oraclecloud.com/n/your-tenancy-namespace/b/ems-shopify-media/o/

# Uploads Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
